#!/usr/bin/python3 -cimport os, sys; os.execv(os.path.dirname(sys.argv[1]) + "/common/pywrap", sys.argv)

# Run this with --help to see available options for tracing and debugging
# See https://github.com/cockpit-project/cockpit/blob/main/test/common/testlib.py
# "class Browser" and "class MachineCase" for the available API.

import testlib

SSG_CONTENT_GLOB = "/usr/share/xml/scap/ssg/content/ssg-*-ds.xml"


# Nondestructive tests all run in the same running VM. This allows them to run in Packit, Fedora, and
# RHEL dist-git gating. They must not permanently change any file or configuration on the system in a
# way that influences other tests.
@testlib.nondestructive
class TestOscap(testlib.MachineCase):
    def setUp(self) -> None:
        super().setUp()
        # the page is only offered by Cockpit when oscap is installed
        if not self.machine.execute("command -v oscap || true").strip():
            self.skipTest("oscap is not installed in this image")
        self.has_content = bool(self.machine.execute(f"ls {SSG_CONTENT_GLOB} 2>/dev/null || true").strip())

    def testBasic(self) -> None:
        b = self.browser

        self.login_and_go("/oscap")

        if not self.has_content:
            # without SCAP Security Guide content the page explains what to install
            b.wait_in_text(".pf-v6-c-empty-state", "No SCAP content found")
            return

        b.wait_visible("#oscap-tabs")
        b.wait_visible("#run-scan")
        # a fresh system has no results yet
        b.wait_in_text("#page-overview", "No compliance scans yet")

        b.click("#oscap-tabs button:contains('Profiles')")
        b.wait_visible("#profiles-toolbar")
        b.wait_visible(".oscap-profile-card")

        b.click("#oscap-tabs button:contains('Results')")
        b.wait_in_text("#page-results", "No scan results yet")

        b.click("#oscap-tabs button:contains('Schedule')")
        b.wait_visible("#schedule-status")
        b.wait_visible("#schedule-form")

    def testScanDialog(self) -> None:
        b = self.browser

        if not self.has_content:
            self.skipTest("no SCAP Security Guide content in this image")

        self.login_and_go("/oscap")
        b.wait_visible("#oscap-tabs")
        b.click("#run-scan")
        b.wait_visible("#scan-dialog")
        # the profile selector is populated from the datastream
        b.wait_visible("#scan-start:not([disabled])")
        b.click("#scan-dialog button:contains('Cancel')")
        b.wait_not_present("#scan-dialog")

    @testlib.timeout(1200)
    def testScan(self) -> None:
        b = self.browser

        if not self.has_content:
            self.skipTest("no SCAP Security Guide content in this image")

        # the scan writes results and state under /var/lib/cockpit-oscap; leave the VM as it was
        # (restore_dir removes the directory again when it did not exist before). Should the test
        # give up on a slow scan, stop oscap first: the bridge keeps scanning after the page is gone
        # and would write its result after the restore.
        self.restore_dir("/var/lib/cockpit-oscap")
        self.addCleanup(self.machine.execute,
                        "pkill -x oscap || true; "
                        "for i in $(seq 40); do pgrep -x oscap >/dev/null || break; sleep 0.5; done; sleep 1")

        self.login_and_go("/oscap")
        b.wait_visible("#oscap-tabs")
        b.click("#run-scan")
        b.wait_visible("#scan-dialog")
        b.wait_visible("#scan-start:not([disabled])")
        b.click("#scan-start")
        b.wait_visible("#scan-progress")
        # a complete profile takes a while on a test VM
        with b.wait_timeout(900):
            b.wait_visible("#scan-view-results")
        b.click("#scan-view-results")

        # the result page: summary, every rule, details on demand
        b.wait_visible("#result-summary")
        b.wait_in_text("#result-summary", "%")
        # ListingTable renders one <tbody> per row
        b.wait_visible("#result-rules tbody:first-of-type > tr")
        b.click("#result-rules tbody:first-of-type > tr td.pf-v6-c-table__toggle button")
        b.wait_in_text("#result-rules tr:not([hidden]) .oscap-expanded-details", "Rule ID")
        b.click("#result-actions")
        b.wait_visible(".pf-v6-c-menu__item:contains('Download HTML report')")
        b.wait_visible(".pf-v6-c-menu__item:contains('Download rule results (CSV)')")
        b.key("Escape")

        # the scan shows up in the history, which the search narrows
        b.click("nav.pf-v6-c-breadcrumb a:contains('Results')")
        b.wait_visible("#results-table tbody:first-of-type > tr")
        b.wait_in_text(".oscap-toolbar-count", "1 scan")
        b.set_input_text("#results-search", "no such profile")
        b.wait_in_text("#results-table", "No scans match the search")
        b.wait_in_text(".oscap-toolbar-count", "0 scans")
        b.set_input_text("#results-search", "")
        b.wait_visible("#results-table tbody:first-of-type > tr")

        # ... and on the overview, where a rule needing attention links to itself on the result page,
        # expanded (a fresh test VM never passes a whole profile)
        b.click("#oscap-tabs button:contains('Overview')")
        b.wait_visible("#overview-latest")
        b.wait_in_text("#overview-latest", "%")
        b.wait_visible("#overview-failed tbody:first-of-type > tr")
        b.click("#overview-failed tbody:first-of-type > tr")
        b.wait_visible("#result-rules")
        b.wait_in_text("#result-rules tr:not([hidden]) .oscap-expanded-details", "Rule ID")

        # a failed rule can be excluded from the profile with a justification, which the
        # customization keeps as an XCCDF remark
        b.click("#result-rules tr:not([hidden]) button[id^='exclude-']")
        b.wait_visible("#exclude-rule-dialog")
        b.wait_visible("#exclude-rule-confirm[disabled]")
        b.set_input_text("#exclude-rule-remark", "Not applicable on this host")
        b.click("#exclude-rule-confirm")
        b.wait_visible("#result-excluded-notice")
        self.machine.execute("grep -q '<xccdf:remark>Not applicable on this host</xccdf:remark>' "
                             "/var/lib/cockpit-oscap/tailoring/*.xml")

        self._check_comparison_picker()

    def _check_comparison_picker(self) -> None:
        """The comparison picks any earlier scan of the profile: fake two, from copies of the newest
        result (a second real scan would double the test's time), and follow a link naming one."""
        b = self.browser
        self.machine.execute(
            "cd /var/lib/cockpit-oscap/results && python3 - <<'PYEOF'\n"
            "import glob, json, shutil\n"
            "newest = sorted(glob.glob('*.json'))[-1]\n"
            "profile = newest[len('2026-01-01T000000-'):-len('.json')]\n"
            "for day, hour in (('01', '00'), ('02', '00')):\n"
            "    stem = f'2001-01-{day}T{hour}0000-{profile}'\n"
            "    data = json.load(open(newest))\n"
            "    data['id'] = stem\n"
            "    data['timestamp'] = f'2001-01-{day}T{hour}:00:00+00:00'\n"
            "    json.dump(data, open(stem + '.json', 'w'))\n"
            "    shutil.copy(newest[:-len('.json')] + '.arf.xml', stem + '.arf.xml')\n"
            "PYEOF")
        current = self.machine.execute("ls /var/lib/cockpit-oscap/results/2026*.json | sort | tail -1").strip()
        current = current.rsplit("/", 1)[1][:-len(".json")]
        profile = current[len("2026-01-01T000000-"):]
        b.go(f"#/results/{current}")
        b.wait_visible("button#result-compare")
        b.wait_in_text("#result-compare", "Jan 2, 2001")
        b.go(f"#/results/{current}?compare=2001-01-01T000000-{profile}")
        b.wait_in_text("#result-compare", "Jan 1, 2001")
        b.wait_in_text("#result-summary", "Since the chosen scan")

    def testProfileEditor(self) -> None:
        b = self.browser

        if not self.has_content:
            self.skipTest("no SCAP Security Guide content in this image")

        # saving a customization writes under /var/lib/cockpit-oscap; leave the VM as it was
        self.restore_dir("/var/lib/cockpit-oscap")

        # the content ships several profiles; work on the first card throughout
        self.login_and_go("/oscap#/profiles")
        b.wait_visible(".oscap-profile-card:first-of-type")
        b.click(".oscap-profile-card:first-of-type button:contains('Customize')")
        b.wait_visible("#tailoring-editor")
        b.wait_visible("#tailoring-rules")
        # nothing is changed yet, so there is nothing to save
        b.wait_visible("#tailoring-save[disabled]")
        b.click("#tailoring-tabs button:contains('Values')")
        b.wait_visible("#tailoring-values")
        b.click("#tailoring-tabs button:contains('Rules')")

        # toggle one rule, justify it, review the change, save it
        b.click("#tailoring-rules tbody:first-of-type label.pf-v6-c-switch")
        b.wait_visible("#tailoring-review")
        b.wait_in_text("#tailoring-review", "1 unsaved change")
        b.click("#tailoring-rules tbody:first-of-type td.pf-v6-c-table__toggle button")
        b.set_input_text("#tailoring-rules tbody:first-of-type input[id^='remark-']", "Covered elsewhere, ticket 42")
        b.click("#tailoring-review")
        b.wait_visible("#tailoring-review-dialog")
        b.wait_in_text("#tailoring-review-dialog", "Rule ")
        b.wait_in_text("#tailoring-review-dialog", "ticket 42")
        b.click("#tailoring-review-dialog button:contains('Close')")
        b.wait_not_present("#tailoring-review-dialog")
        b.click("#tailoring-save")
        b.wait_in_text("#tailoring-editor .pf-v6-c-alert", "saved")
        b.wait_visible("#tailoring-save[disabled]")
        # the justification is an XCCDF remark in the tailoring file
        # (execute raises when grep finds nothing)
        self.machine.execute("grep -q '<xccdf:remark>Covered elsewhere, ticket 42</xccdf:remark>' "
                             "/var/lib/cockpit-oscap/tailoring/*.xml")

        # the profile card shows the customization, and can drop it again
        b.click("nav.pf-v6-c-breadcrumb a:contains('Profiles')")
        b.wait_visible(".oscap-profile-card:first-of-type .pf-v6-c-label:contains('Customized')")
        b.click(".oscap-profile-card:first-of-type button[id^='profile-actions-']")
        b.click(".pf-v6-c-menu__item:contains('Remove customizations')")
        b.click(".pf-v6-c-modal-box button:contains('Remove')")
        b.wait_not_present(".oscap-profile-card .pf-v6-c-label:contains('Customized')")


if __name__ == '__main__':
    testlib.test_main()
