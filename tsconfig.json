{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "exactOptionalPropertyTypes": true,
    "jsx": "react",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "paths": {
      "*": [
        "./pkg/lib/*"
      ]
    },
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*",
    "test/unit/**/*"
  ]
}
